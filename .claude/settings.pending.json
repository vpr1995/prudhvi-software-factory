{
  "$comment": "Generated by scripts/gates/build-settings.mjs from scripts/gates/gate-files.json. Do not edit by hand. A human copies this file to .claude/settings.json (a gate file) after review.",
  "permissions": {
    "allow": [
      "Bash(node common/scripts/install-run-rush.js:*)",
      "Bash(node scripts/gates/anti-skip.mjs:*)",
      "Bash(node scripts/gates/bruno-coverage.mjs:*)",
      "Bash(node scripts/gates/playwright-coverage.mjs:*)",
      "Bash(bash .claude/hooks/stop-gate.sh --write-state-only)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Edit(/.github/**)",
      "Edit(**/CODEOWNERS)",
      "Edit(/.claude/settings*.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/tooling/**)",
      "Edit(**/.gitleaks.toml)",
      "Edit(**/audit-ci.jsonc)",
      "Edit(**/.checkov.yaml)",
      "Edit(/docs/standards/coding-conventions.md)",
      "Edit(/common/config/rush/**)",
      "Edit(/common/git-hooks/**)",
      "Edit(/common/autoinstallers/**)",
      "Edit(**/rush.json)",
      "Edit(/scripts/check-gates.ts)",
      "Edit(/scripts/classify-risk.ts)",
      "Edit(**/REVIEW.md)",
      "Edit(/platform/infra/**)",
      "Edit(**/rush-project.json)",
      "Edit(**/eslint.config.*)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/vitest.config.*)",
      "Edit(**/.dependency-cruiser.*)",
      "Edit(**/cdk.json)",
      "Edit(**/playwright.config.*)",
      "Edit(**/pyproject.toml)",
      "Edit(**/.golangci.yml)",
      "Edit(**/uv.lock)",
      "Edit(**/go.sum)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/package-lock.json)",
      "Edit(**/yarn.lock)",
      "Edit(/scripts/gates/**)",
      "Edit(/scripts/security/**)",
      "Edit(/scripts/git/**)",
      "Edit(**/.lintstagedrc.cjs)",
      "Edit(**/commitlint.config.cjs)",
      "Edit(/.git/hooks/**)",
      "Edit(**/.gitattributes)",
      "Edit(/common/scripts/**)",
      "Edit(**/scripts/*.sh)",
      "Edit(**/scripts/*.mjs)",
      "Edit(**/scripts/*.py)",
      "Edit(**/.gitignore)",
      "Edit(**/pytest.toml)",
      "Edit(**/go.mod)",
      "Edit(**/bruno.json)",
      "Edit(**/pytest.ini)",
      "Edit(**/ruff.toml)",
      "Edit(**/.ruff.toml)",
      "Edit(**/mypy.ini)",
      "Edit(**/.coveragerc)",
      "Edit(**/setup.cfg)",
      "Edit(**/tox.ini)",
      "Edit(/.claude/state/last-verify.json)",
      "Edit(/.claude/state/session-base)",
      "Edit(/.claude/state/stop-attempts)",
      "Edit(/.claude/state/subagent-stop-attempts)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prompt-context.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-gates.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-verify.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-project.sh",
            "timeout": 240
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-bash.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-bash.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "timeout": 3600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh --fast",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
