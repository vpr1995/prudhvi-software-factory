{
  "permissions": {
    "allow": [
      "Bash(node common/scripts/install-run-rush.js:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": ["Read(**/.env)", "Read(**/.env.*)", "Read(~/.aws/**)", "Read(~/.ssh/**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/tooling/eslint-config/scripts/lint-on-edit.mjs",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
