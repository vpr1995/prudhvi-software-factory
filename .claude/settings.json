{
  "permissions": {
    "allow": [
      "Bash(node common/scripts/install-run-rush.js:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(* --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(cdk deploy*)",
      "Bash(* cdk deploy*)",
      "Bash(cdk destroy*)",
      "Bash(* cdk destroy*)",
      "Bash(npm install*)",
      "Bash(npm i)",
      "Bash(npm i *)",
      "Bash(pnpm install*)",
      "Bash(pnpm i)",
      "Bash(pnpm i *)",
      "Bash(pnpm add*)",
      "Bash(yarn add*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/tooling/eslint-config/scripts/lint-on-edit.mjs",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
