/**
 * Rush monorepo configuration. Gate file: agents must not edit it (see CLAUDE.md).
 * Docs: https://rushjs.io/pages/configs/rush_json/
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",

  "rushVersion": "5.181.0",
  "pnpmVersion": "10.34.7",
  "nodeSupportedVersionRange": ">=24.11.1 <25.0.0",

  /** Projects live at tooling/<name>, packages/<name>, projects/<name>/<kind>. */
  "projectFolderMinDepth": 1,
  "projectFolderMaxDepth": 3,

  "gitPolicy": {
    // Optional: restrict commit emails, for example with "allowedEmailRegExps".
  },

  "repository": {
    // Placeholder. Replace with the real remote URL before the first push.
    "url": "https://github.com/OWNER/projects-monorepo.git",
    "defaultBranch": "main",
    "defaultRemote": "origin"
  },

  "eventHooks": {
    "preRushInstall": [],
    "postRushInstall": [],
    "preRushBuild": [],
    "postRushBuild": []
  },

  "projects": [
    {
      "packageName": "@vprprudhvi/tooling-tsconfig",
      "projectFolder": "tooling/tsconfig",
      "shouldPublish": false,
      "tags": ["tooling"]
    },
    {
      "packageName": "@vprprudhvi/tooling-vitest-config",
      "projectFolder": "tooling/vitest-config",
      "shouldPublish": false,
      "tags": ["tooling"]
    },
    {
      "packageName": "@vprprudhvi/tooling-eslint-config",
      "projectFolder": "tooling/eslint-config",
      "shouldPublish": false,
      "tags": ["tooling"]
    },
    {
      "packageName": "@vprprudhvi/shared-result",
      "projectFolder": "packages/result",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/shared-telemetry",
      "projectFolder": "packages/telemetry",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/shared-logger",
      "projectFolder": "packages/logger",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/shared-flags",
      "projectFolder": "packages/flags",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/sample-fullstack-contracts",
      "projectFolder": "projects/sample-fullstack/contracts",
      "shouldPublish": false,
      "tags": ["project/sample-fullstack", "kind/contracts"]
    },
    {
      "packageName": "@vprprudhvi/sample-fullstack-api",
      "projectFolder": "projects/sample-fullstack/api",
      "shouldPublish": false,
      "tags": ["project/sample-fullstack", "kind/api"]
    },
    {
      "packageName": "@vprprudhvi/sample-api-only-contracts",
      "projectFolder": "projects/sample-api-only/contracts",
      "shouldPublish": false,
      "tags": ["project/sample-api-only", "kind/contracts"]
    },
    {
      "packageName": "@vprprudhvi/sample-api-only-api",
      "projectFolder": "projects/sample-api-only/api",
      "shouldPublish": false,
      "tags": ["project/sample-api-only", "kind/api"]
    },
    {
      "packageName": "@vprprudhvi/sample-api-only-api-py",
      "projectFolder": "projects/sample-api-only/api-py",
      "shouldPublish": false,
      "tags": ["project/sample-api-only", "kind/api-py"]
    },
    {
      "packageName": "@vprprudhvi/sample-api-only-api-go",
      "projectFolder": "projects/sample-api-only/api-go",
      "shouldPublish": false,
      "tags": ["project/sample-api-only", "kind/api-go"]
    },
    {
      "packageName": "@vprprudhvi/sample-fullstack-web",
      "projectFolder": "projects/sample-fullstack/web",
      "shouldPublish": false,
      "tags": ["project/sample-fullstack", "kind/web"]
    }
  ]
}
