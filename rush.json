/**
 * Rush monorepo configuration. Gate file: agents must not edit it (see CLAUDE.md).
 * Docs: https://rushjs.io/pages/configs/rush_json/
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",

  "rushVersion": "5.181.0",
  "pnpmVersion": "10.34.7",
  "nodeSupportedVersionRange": ">=24.11.1 <25.0.0",

  /** Projects live at tooling/<name>, packages/<name>, projects/<name>. */
  "projectFolderMinDepth": 1,
  "projectFolderMaxDepth": 3,

  "gitPolicy": {
    // Optional: restrict commit emails, for example with "allowedEmailRegExps".
  },

  "repository": {
    // Local bare repo (owner decision 2026-10-23). Rush matches it to the "origin" remote as a plain
    // path (a file:// URL does not match). Replace with the real remote URL when one exists.
    "url": "/Users/PrudhviGenie/Desktop/Dev/projects-monorepo.git",
    "defaultBranch": "main",
    "defaultRemote": "origin"
  },

  "eventHooks": {
    "preRushInstall": [],
    "postRushInstall": [],
    "preRushBuild": [],
    "postRushBuild": []
  },

  "projects": [
    {
      "packageName": "@vprprudhvi/tooling-tsconfig",
      "projectFolder": "tooling/tsconfig",
      "shouldPublish": false,
      "tags": ["tooling"]
    },
    {
      "packageName": "@vprprudhvi/tooling-vitest-config",
      "projectFolder": "tooling/vitest-config",
      "shouldPublish": false,
      "tags": ["tooling"]
    },
    {
      "packageName": "@vprprudhvi/tooling-eslint-config",
      "projectFolder": "tooling/eslint-config",
      "shouldPublish": false,
      "tags": ["tooling"]
    },
    {
      "packageName": "@vprprudhvi/shared-result",
      "projectFolder": "packages/result",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/shared-telemetry",
      "projectFolder": "packages/telemetry",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/shared-logger",
      "projectFolder": "packages/logger",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/shared-flags",
      "projectFolder": "packages/flags",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/sample",
      "projectFolder": "projects/sample",
      "shouldPublish": false,
      "tags": ["project/sample"]
    },
    {
      "packageName": "@vprprudhvi/shared-cdk-constructs",
      "projectFolder": "packages/cdk-constructs",
      "shouldPublish": true,
      "tags": ["shared"]
    },
    {
      "packageName": "@vprprudhvi/platform-infra",
      "projectFolder": "platform/infra",
      "shouldPublish": false,
      "tags": ["platform"]
    }
  ]
}
