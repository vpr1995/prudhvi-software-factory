{
  "name": "@vprprudhvi/platform-infra",
  "version": "0.0.0",
  "private": true,
  "description": "Platform CDK app: one Cognito user pool, the imported Route53 hosted zone, the ACM wildcard certificate, and their SSM parameters.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "_phase:build": "tsc -p tsconfig.build.json",
    "_phase:lint": "eslint --max-warnings 0 .",
    "_phase:test": "vitest run --coverage",
    "_phase:typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run _phase:build",
    "lint": "npm run _phase:lint",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck",
    "synth": "cdk synth"
  },
  "dependencies": {
    "@vprprudhvi/shared-cdk-constructs": "workspace:*",
    "aws-cdk-lib": "2.273.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vprprudhvi/tooling-eslint-config": "workspace:*",
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@vprprudhvi/tooling-vitest-config": "workspace:*",
    "aws-cdk": "2.1145.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
