{
  "extends": "@vprprudhvi/tooling-tsconfig/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "src",
    "e2e",
    "test",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
