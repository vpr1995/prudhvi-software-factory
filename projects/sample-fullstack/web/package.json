{
  "name": "@vprprudhvi/sample-fullstack-web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js App Router web app of sample-fullstack.",
  "type": "module",
  "scripts": {
    "_phase:build": "next build",
    "_phase:e2e": "playwright install chromium && playwright test",
    "_phase:lint": "eslint --max-warnings 0 .",
    "_phase:test": "vitest run --coverage",
    "_phase:typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "build": "npm run _phase:build",
    "dev": "next dev",
    "e2e": "npm run _phase:e2e",
    "lint": "npm run _phase:lint",
    "start": "next start",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "dependencies": {
    "@vprprudhvi/sample-fullstack-contracts": "workspace:*",
    "@vprprudhvi/shared-result": "workspace:*",
    "@vprprudhvi/shared-telemetry": "workspace:*",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vprprudhvi/sample-fullstack-api": "workspace:*",
    "@vprprudhvi/tooling-eslint-config": "workspace:*",
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@vprprudhvi/tooling-vitest-config": "workspace:*",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
