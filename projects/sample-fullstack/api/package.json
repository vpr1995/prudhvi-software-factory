{
  "name": "@vprprudhvi/sample-fullstack-api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API of sample-fullstack. Runs on Lambda (src/lambda.ts) or locally (src/main.ts).",
  "type": "module",
  "main": "./dist/lambda.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "_phase:build": "tsc -p tsconfig.build.json",
    "_phase:e2e": "node scripts/e2e.mjs",
    "_phase:lint": "eslint --max-warnings 0 .",
    "_phase:test": "vitest run --coverage",
    "_phase:typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run _phase:build",
    "e2e": "npm run _phase:e2e",
    "lint": "npm run _phase:lint",
    "start": "node dist/main.js",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "~13.2.0",
    "@fastify/otel": "^0.21.0",
    "@fastify/swagger": "^9.5.1",
    "@opentelemetry/api": "~1.9.1",
    "@vprprudhvi/sample-fullstack-contracts": "workspace:*",
    "@vprprudhvi/shared-logger": "workspace:*",
    "@vprprudhvi/shared-result": "workspace:*",
    "@vprprudhvi/shared-telemetry": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@usebruno/cli": "4.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vprprudhvi/tooling-eslint-config": "workspace:*",
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@vprprudhvi/tooling-vitest-config": "workspace:*",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
