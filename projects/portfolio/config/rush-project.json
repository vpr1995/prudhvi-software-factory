{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush-project.schema.json",
  "operationSettings": [
    // The web part writes symlinks into web/.next/node_modules (Turbopack). Rush cannot put
    // symlinks in the build cache, so the build phase is not cached.
    {
      "operationName": "_phase:build",
      "outputFolderNames": ["dist", "web/.next"],
      "disableBuildCacheForOperation": true
    },
    { "operationName": "_phase:test", "outputFolderNames": ["coverage"] },
    { "operationName": "_phase:e2e", "disableBuildCacheForOperation": true }
  ]
}
