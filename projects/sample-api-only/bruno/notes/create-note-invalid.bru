meta {
  name: Create note with an invalid body
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/notes
  body: json
  auth: none
}

body:json {
  {
    "title": ""
  }
}

docs {
  Purpose: shows the validation error.
  Auth: none.
  Errors: 400 VALIDATION_ERROR. The body is the error envelope, and requestId is the trace id.
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_ERROR
  res.headers.traceparent: matches ^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$
}

tests {
  test("requestId equals the trace id of the traceparent header", function () {
    const traceId = res.getHeader("traceparent").split("-")[1];
    expect(res.body.error.requestId).to.equal(traceId);
  });
}
