{
  "description": "Shared edge cases for POST /v1/notes. The Zod schema in contracts/src/note.ts is the reference. contracts, api-py and api-go all run these cases. A case with status 201 also gives the title and the body of the stored note (the title is trimmed).",
  "cases": [
    {
      "name": "minimal valid note",
      "raw": "{\"title\": \"a\"}",
      "status": 201,
      "title": "a",
      "body": ""
    },
    {
      "name": "title and body",
      "raw": "{\"title\": \"Plan\", \"body\": \"text\"}",
      "status": 201,
      "title": "Plan",
      "body": "text"
    },
    {
      "name": "title of 120 characters",
      "raw": "{\"title\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}",
      "status": 201,
      "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "body": ""
    },
    {
      "name": "120 characters padded with spaces",
      "raw": "{\"title\": \"  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  \"}",
      "status": 201,
      "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "body": ""
    },
    {
      "name": "120 characters padded with tab and newline",
      "raw": "{\"title\": \"\\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\n\"}",
      "status": 201,
      "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "body": ""
    },
    {
      "name": "title of 121 characters",
      "raw": "{\"title\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}",
      "status": 400
    },
    {
      "name": "121 characters padded with spaces",
      "raw": "{\"title\": \" aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \"}",
      "status": 400
    },
    {
      "name": "whitespace-only title",
      "raw": "{\"title\": \"   \"}",
      "status": 400
    },
    {
      "name": "empty title",
      "raw": "{\"title\": \"\"}",
      "status": 400
    },
    {
      "name": "missing title",
      "raw": "{\"body\": \"x\"}",
      "status": 400
    },
    {
      "name": "null title",
      "raw": "{\"title\": null}",
      "status": 400
    },
    {
      "name": "null body",
      "raw": "{\"title\": \"a\", \"body\": null}",
      "status": 400
    },
    {
      "name": "body of 2000 characters",
      "raw": "{\"title\": \"a\", \"body\": \"\"}",
      "status": 201,
      "title": "a",
      "body": ""
    },
    {
      "name": "body of 2001 characters",
      "raw": "{\"title\": \"a\", \"body\": \"\"}",
      "status": 400
    },
    {
      "name": "unknown field",
      "raw": "{\"title\": \"a\", \"extra\": 1}",
      "status": 400
    },
    {
      "name": "title is a number",
      "raw": "{\"title\": 5}",
      "status": 400
    },
    {
      "name": "body is a number",
      "raw": "{\"title\": \"a\", \"body\": 5}",
      "status": 400
    },
    {
      "name": "not JSON",
      "raw": "{",
      "status": 400
    },
    {
      "name": "JSON null",
      "raw": "null",
      "status": 400
    },
    {
      "name": "JSON array",
      "raw": "[]",
      "status": 400
    },
    {
      "name": "empty request body",
      "raw": "",
      "status": 400
    }
  ]
}
