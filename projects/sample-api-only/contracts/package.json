{
  "name": "@vprprudhvi/sample-api-only-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and the OpenAPI document for sample-api-only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./dist/openapi.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "_phase:build": "tsc -p tsconfig.build.json && node scripts/emit-openapi.mjs > dist/openapi.json",
    "_phase:lint": "eslint --max-warnings 0 .",
    "_phase:test": "vitest run --coverage",
    "_phase:typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run _phase:build",
    "lint": "npm run _phase:lint",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vprprudhvi/tooling-eslint-config": "workspace:*",
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@vprprudhvi/tooling-vitest-config": "workspace:*",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
