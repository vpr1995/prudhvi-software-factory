{
  "name": "@vprprudhvi/sample-api-only-api-py",
  "version": "0.0.0",
  "private": true,
  "description": "Python API of sample-api-only. Thin Rush wrapper: each _phase script calls uv and the Python tools.",
  "scripts": {
    "_phase:build": "uv run --locked python -m compileall -q src",
    "_phase:e2e": "uv sync --locked --quiet && node scripts/e2e.mjs",
    "_phase:lint": "bash scripts/lint.sh",
    "_phase:test": "uv run --locked pytest",
    "_phase:typecheck": "uv run --locked mypy",
    "build": "npm run _phase:build",
    "e2e": "npm run _phase:e2e",
    "gen": "bash scripts/generate-models.sh",
    "license-check": "bash scripts/license-check.sh",
    "lint": "npm run _phase:lint",
    "security": "bash scripts/security.sh",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "devDependencies": {
    "@usebruno/cli": "4.2.1",
    "@vprprudhvi/sample-api-only-contracts": "workspace:*"
  }
}
