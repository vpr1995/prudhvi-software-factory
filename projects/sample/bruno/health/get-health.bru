meta {
  name: Get health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/health
  body: none
  auth: none
}

docs {
  Purpose: returns the service name and version when the service is up.
  Auth: none.
  Errors: none expected.
  Trace: the response header traceparent holds the trace id of the request.
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.service: startsWith sample-api
  res.headers.traceparent: matches ^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  test("response has a traceparent header", function () {
    expect(res.getHeader("traceparent")).to.match(/^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$/);
  });
}
