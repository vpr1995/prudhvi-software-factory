{
  "name": "@vprprudhvi/sample",
  "version": "0.0.0",
  "private": true,
  "description": "The sample project: contracts, TypeScript, Python and Go APIs, Next.js web app and Bruno collection in one package. The CDK app (bin, lib) comes in Wave 3.",
  "type": "module",
  "main": "./dist/api/lambda.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "_phase:build": "node scripts/phase.mjs build",
    "_phase:e2e": "node scripts/phase.mjs e2e",
    "_phase:lint": "node scripts/phase.mjs lint",
    "_phase:test": "node scripts/phase.mjs test",
    "_phase:typecheck": "node scripts/phase.mjs typecheck",
    "build": "npm run _phase:build",
    "dev:web": "cd web && next dev",
    "e2e": "npm run _phase:e2e",
    "gen:go": "bash src/api-go/scripts/generate-types.sh",
    "gen:py": "bash src/api-py/scripts/generate-models.sh",
    "license-check": "bash src/api-py/scripts/license-check.sh && bash src/api-go/scripts/license-check.sh",
    "lint": "npm run _phase:lint",
    "security": "bash src/api-py/scripts/security.sh && bash src/api-go/scripts/security.sh",
    "start": "node dist/api/main.js",
    "start:web": "cd web && next start",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-go-alpha": "2.273.0-alpha.0",
    "@aws-cdk/aws-lambda-python-alpha": "2.273.0-alpha.0",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "~13.2.0",
    "@fastify/otel": "^0.21.0",
    "@fastify/swagger": "^9.5.1",
    "@opentelemetry/api": "~1.9.1",
    "@vprprudhvi/shared-cdk-constructs": "workspace:*",
    "@vprprudhvi/shared-logger": "workspace:*",
    "@vprprudhvi/shared-result": "workspace:*",
    "@vprprudhvi/shared-telemetry": "workspace:*",
    "aws-cdk-lib": "2.273.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "next": "^16.4.2",
    "openapi-types": "^12.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/aws": "4.1.11",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@usebruno/cli": "4.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vprprudhvi/tooling-eslint-config": "workspace:*",
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@vprprudhvi/tooling-vitest-config": "workspace:*",
    "aws-cdk": "2.1145.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
