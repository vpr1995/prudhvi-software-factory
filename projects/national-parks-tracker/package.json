{
  "name": "@vprprudhvi/national-parks-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "A static map of the 64 US national parks that shows which parks the owner has visited. Contracts (Zod) and a Next.js static export in one package.",
  "type": "module",
  "scripts": {
    "_phase:build": "node scripts/phase.mjs build",
    "_phase:e2e": "node scripts/phase.mjs e2e",
    "_phase:lint": "node scripts/phase.mjs lint",
    "_phase:test": "node scripts/phase.mjs test",
    "_phase:typecheck": "node scripts/phase.mjs typecheck",
    "build": "npm run _phase:build",
    "dev:web": "cd web && next dev",
    "e2e": "npm run _phase:e2e",
    "lint": "npm run _phase:lint",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vprprudhvi/tooling-eslint-config": "workspace:*",
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@vprprudhvi/tooling-vitest-config": "workspace:*",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
