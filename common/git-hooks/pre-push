#!/bin/sh
# Installed by `rush install`. Runs `rush audit` when the pnpm lockfile changed since origin/main.
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"
lock="common/config/rush/pnpm-lock.yaml"

if ! base="$(git merge-base HEAD origin/main 2>/dev/null)"; then
  echo "pre-push: no origin/main, audit skipped" >&2
  exit 0
fi

if git diff --name-only "$base" HEAD -- "$lock" | grep -q .; then
  echo "pre-push: $lock changed, running rush audit"
  exec node common/scripts/install-run-rush.js audit </dev/null
fi
echo "pre-push: $lock not changed, audit skipped"
