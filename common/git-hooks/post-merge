#!/bin/sh
# Prints a reminder when the lockfile or Rush config changed. Never blocks.
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -E '^(common/config/rush/pnpm-lock\.yaml|rush\.json)$' >/dev/null; then
  echo "post-merge: dependencies or rush.json changed. Run: node common/scripts/install-run-rush.js install" >&2
fi
exit 0
