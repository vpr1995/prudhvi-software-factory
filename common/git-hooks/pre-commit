#!/bin/sh
# Installed by `rush install` (copied from common/git-hooks). Blocks the commit when a check fails.
# Checks: secret scan (gitleaks), then Prettier and ESLint on staged files (lint-staged).
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"
[ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ] || exit 0

# 1. Secret scan on staged changes (gitleaks).
bash scripts/security/secrets-staged.sh

# 2. Prettier and ESLint on staged files (lint-staged).
# Calls the autoinstaller binary directly, so the hook does not wait on the Rush lock.
# Falls back to `rush prettier` (installs the autoinstaller).
bin="$root/common/autoinstallers/rush-lint-staged/node_modules/.bin"
if [ -x "$bin/lint-staged" ]; then
  PATH="$bin:$PATH" bash scripts/git/lint-staged.sh
else
  node common/scripts/install-run-rush.js prettier
fi
