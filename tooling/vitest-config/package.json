{
  "name": "@vprprudhvi/tooling-vitest-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vitest config factory with fixed coverage thresholds. Gate file.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "_phase:build": "tsc -p tsconfig.build.json",
    "_phase:lint": "eslint --max-warnings 0 .",
    "_phase:test": "vitest run --coverage",
    "_phase:typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run _phase:build",
    "lint": "npm run _phase:lint",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vite": "^7.3.0"
  }
}
