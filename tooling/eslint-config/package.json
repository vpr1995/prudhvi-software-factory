{
  "name": "@vprprudhvi/tooling-eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint 9 flat configs and custom rules. Gate file.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "_phase:build": "node scripts/smoke.js",
    "_phase:lint": "eslint --max-warnings 0 .",
    "_phase:test": "vitest run --coverage",
    "_phase:typecheck": "tsc -p tsconfig.json",
    "build": "npm run _phase:build",
    "lint": "npm run _phase:lint",
    "test": "npm run _phase:test",
    "typecheck": "npm run _phase:typecheck"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "~7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "ts-declaration-location": "^1.0.7",
    "typescript-eslint": "^8.72.0"
  },
  "peerDependencies": {
    "eslint": "^10.13.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^24.19.2",
    "@typescript-eslint/types": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vprprudhvi/tooling-tsconfig": "workspace:*",
    "@vprprudhvi/tooling-vitest-config": "workspace:*",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
