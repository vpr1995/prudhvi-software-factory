{
  "extends": "@vprprudhvi/tooling-tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/rules/**/*.js",
    "src/plugin.js",
    "src/naming.js",
    "src/restricted-syntax.js",
    "test/**/*.js"
  ],
  // configs.test.js imports src/index.js. Type errors in the config sources (untyped plugins) stop
  // the check there. Before the move, no test file had a typecheck. Remove this when they are fixed.
  "exclude": ["test/configs.test.js"]
}
