import { describe, expect, it } from 'vitest';

import { run } from '../../src/api/run.js';

const TRACEPARENT_PATTERN = /^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$/;
const INCOMING_TRACE_ID = '4bf92f3577b34da6a3ce929d0e0e4736';

describe('run', () => {
  it('starts the server, continues the trace, and stop closes it', async () => {
    const before = process.listenerCount('SIGTERM');
    const api = await run({ __NAME___API_PORT: '0', __NAME___API_LOG_LEVEL: 'silent' });
    expect(process.listenerCount('SIGTERM')).toBe(before + 1);
    const address = api.app.server.address();
    const port = typeof address === 'object' && address !== null ? address.port : 0;

    const response = await fetch(`http://127.0.0.1:${String(port)}/v1/health`, {
      headers: { traceparent: `00-${INCOMING_TRACE_ID}-00f067aa0ba902b7-01` },
    });
    expect(response.status).toBe(200);
    const traceparent = response.headers.get('traceparent') ?? '';
    expect(traceparent).toMatch(TRACEPARENT_PATTERN);
    expect(traceparent).toContain(INCOMING_TRACE_ID);

    await api.stop();
    expect(process.listenerCount('SIGTERM')).toBe(before);
  });

  it('stops on SIGTERM', async () => {
    const before = process.listenerCount('SIGTERM');
    await run({ __NAME___API_PORT: '0', __NAME___API_LOG_LEVEL: 'silent' });
    process.emit('SIGTERM');
    expect(process.listenerCount('SIGTERM')).toBe(before);
  });
});
