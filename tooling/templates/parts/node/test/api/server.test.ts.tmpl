import { afterEach, describe, expect, it } from 'vitest';

import { buildServer, startServer } from '../../src/api/server.js';
import type { Server } from '../../src/api/server.js';

import { makeSilentLogger, makeTestConfig } from './support.js';

let app: Server | undefined;

afterEach(async () => {
  await app?.close();
  app = undefined;
});

describe('GET /v1/health', () => {
  it('returns status, service and version', async () => {
    app = await buildServer({ config: makeTestConfig(), logger: makeSilentLogger() });
    const response = await app.inject({ method: 'GET', url: '/v1/health' });
    expect(response.statusCode).toBe(200);
    expect(response.json()).toEqual({ status: 'ok', service: '__name__-api', version: '9.9.9' });
  });

  it('sets the security headers', async () => {
    app = await buildServer({ config: makeTestConfig(), logger: makeSilentLogger() });
    const response = await app.inject({ method: 'GET', url: '/v1/health' });
    expect(response.headers['x-content-type-options']).toBe('nosniff');
    expect(response.headers['content-security-policy']).toContain("default-src 'none'");
    expect(response.headers['x-powered-by']).toBeUndefined();
  });
});

describe('startServer', () => {
  it('listens on the configured port', async () => {
    app = await startServer({
      config: makeTestConfig({ __NAME___API_PORT: '0' }),
      logger: makeSilentLogger(),
    });
    const address = app.server.address();
    const port = typeof address === 'object' && address !== null ? address.port : 0;
    const response = await fetch(`http://127.0.0.1:${String(port)}/v1/health`);
    expect(response.status).toBe(200);
  });
});
